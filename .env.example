# ── Database ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nimbTy"

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="generate-64-bytes-hex"
CRON_SECRET="generate-random"
ARBITER_KEY="generate-random"

# ── Uploads (attachments; wire a blob provider in Phase 4) ──────
BLOB_READ_WRITE_TOKEN=""

# ── Nimiq ────────────────────────────────────────────────────────
NIMIQ_NETWORK="testnet"
# JSON-RPC node URL. REQUIRED on testnet (no public testnet RPC exists —
# run one node, see handoff.md). Mainnet defaults to https://rpc.nimiqwatch.com.
NIMIQ_RPC_URL=""
# Numeric tx network id (verified: TestAlbatross=5, MainAlbatross=24). Auto by NIMIQ_NETWORK.
NIMIQ_NETWORK_ID=""
ESCROW_ACCOUNT_ADDRESS=""
ESCROW_ACCOUNT_PRIVATE_KEY=""
NEXT_PUBLIC_HUB_BASE_URL=""

# ── Dev tooling ──────────────────────────────────────────────────
ALLOW_SEED="false"
# Local dev only: allow throwaway-key logins with free-picked addresses. NEVER true in prod/demo.
ALLOW_UNVERIFIED_WALLET_LOGIN="false"
NEXT_PUBLIC_ALLOW_DEV_WALLET="false"
